<?xml version="1.0" encoding="UTF-8"?>
<!--
  List of all compositions in the library.
  The folder containing this file is the library; path and thumbnail src are
  relative to it. The difficulty levels are the subfolders of each composition
  folder (e.g. oh-christmas-tree/beginner).
  Titles are not stored here but in locales/<lang>/compositions.ftl, as
  difficulty-<id>, tag-<id>, composition-<id> and exercise-<id>.
-->
<library format-version="1">

<difficulties>
  <difficulty id="prep"/>
  <difficulty id="beginner"/>
  <difficulty id="intermediate"/>
  <difficulty id="expert"/>
  <!-- Not a difficulty step: a duet (student part + teacher part in one MusicXML).
       Shown apart from the difficulties; in the player you choose who plays which part. -->
  <difficulty id="duet" kind="duet"/>
</difficulties>

<!-- Categories shown above the pieces (or exercises), in this order. A composition or exercise uses
     them with <tag>id</tag>; only the categories in use in a section appear there. -->
<tags>
  <tag id="children"/>
  <tag id="classical"/>
  <tag id="christmas"/>
  <tag id="birthday"/>
  <!-- exercises -->
  <tag id="warm-up"/>
  <tag id="coordination"/>
  <tag id="scales"/>
  <tag id="chords"/>
</tags>

<compositions>

  <composition id="oh-christmas-tree" path="oh-christmas-tree">
    <composer>Ernst Anschütz</composer>
    <thumbnail src="oh-christmas-tree/thumbnail.png"/>
    <tags>
      <tag>christmas</tag>
    </tags>
  </composition>

  <composition id="silent-night" path="silent-night">
    <composer>Franz Xaver Gruber</composer>
    <thumbnail src="silent-night/thumbnail.png"/>
    <tags>
      <tag>christmas</tag>
    </tags>
  </composition>

  <composition id="happy-birthday" path="happy-birthday">
    <composer>Patty Hill &amp; Mildred Hill</composer>
    <thumbnail src="happy-birthday/thumbnail.png"/>
    <tags>
      <tag>birthday</tag>
    </tags>
  </composition>

  <composition id="fuer-elise" path="fuer-elise">
    <composer>Ludwig van Beethoven</composer>
    <thumbnail src="fuer-elise/thumbnail.png"/>
    <tags>
      <tag>classical</tag>
    </tags>
  </composition>

  <composition id="ode-to-joy" path="ode-to-joy">
    <composer>Ludwig van Beethoven</composer>
    <thumbnail src="ode-to-joy/thumbnail.png"/>
    <tags>
      <tag>classical</tag>
    </tags>
  </composition>

  <composition id="all-my-little-ducklings" path="all-my-little-ducklings">
    <composer>Ernst Anschütz</composer>
    <thumbnail src="all-my-little-ducklings/thumbnail.png"/>
    <tags>
      <tag>children</tag>
    </tags>
  </composition>

  <composition id="die-zauberfloete" path="die-zauberfloete">
    <composer>Wolfgang Amadeus Mozart</composer>
    <thumbnail src="die-zauberfloete/thumbnail.png"/>
    <tags>
      <tag>classical</tag>
    </tags>
  </composition>

</compositions>

<!-- Exercises (scales, chords, …), shown under "Exercises" in the menu, grouped by category and
     sorted by difficulty; within a difficulty in the order of this file (easier ones first). Same structure as a
     composition (difficulty subfolders with full.musicxml and optional lessons); titles are
     exercise-<id> in compositions.ftl. -->
<exercises>

  <exercise id="five-finger-c" path="exercises/five-finger-c">
    <tags>
      <tag>warm-up</tag>
    </tags>
  </exercise>

  <exercise id="alternating-hands" path="exercises/alternating-hands">
    <tags>
      <tag>coordination</tag>
    </tags>
  </exercise>

  <exercise id="hold-and-move" path="exercises/hold-and-move">
    <tags>
      <tag>coordination</tag>
    </tags>
  </exercise>

  <exercise id="contrary-motion" path="exercises/contrary-motion">
    <tags>
      <tag>warm-up</tag>
      <tag>coordination</tag>
    </tags>
  </exercise>

  <exercise id="two-against-one" path="exercises/two-against-one">
    <tags>
      <tag>coordination</tag>
    </tags>
  </exercise>

  <exercise id="c-major-scale" path="exercises/c-major-scale">
    <tags>
      <tag>scales</tag>
    </tags>
  </exercise>

  <exercise id="a-minor-scale" path="exercises/a-minor-scale">
    <tags>
      <tag>scales</tag>
    </tags>
  </exercise>

  <exercise id="c-major-triads" path="exercises/c-major-triads">
    <tags>
      <tag>chords</tag>
    </tags>
  </exercise>

  <exercise id="broken-chords" path="exercises/broken-chords">
    <tags>
      <tag>chords</tag>
    </tags>
  </exercise>

  <exercise id="c-major-chords" path="exercises/c-major-chords">
    <tags>
      <tag>chords</tag>
    </tags>
  </exercise>

  <exercise id="melody-and-accompaniment" path="exercises/melody-and-accompaniment">
    <tags>
      <tag>coordination</tag>
    </tags>
  </exercise>

  <exercise id="g-major-scale" path="exercises/g-major-scale">
    <tags>
      <tag>scales</tag>
    </tags>
  </exercise>

  <exercise id="f-major-scale" path="exercises/f-major-scale">
    <tags>
      <tag>scales</tag>
    </tags>
  </exercise>

  <exercise id="c-major-inversions" path="exercises/c-major-inversions">
    <tags>
      <tag>chords</tag>
    </tags>
  </exercise>

</exercises>

</library>
