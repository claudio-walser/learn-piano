<?xml version="1.0" encoding="UTF-8"?>
<!--
  List of all compositions in the library.
  The folder containing this file is the library; path and thumbnail src are
  relative to it. The difficulty levels are the subfolders of each composition
  folder (e.g. oh-christmas-tree/beginner).
-->
<library format-version="1">

<difficulties>
  <difficulty id="prep">
    <title xml:lang="de">Vorstufe</title>
    <title xml:lang="en">Prep</title>
  </difficulty>

  <difficulty id="beginner">
    <title xml:lang="de">Anfänger</title>
    <title xml:lang="en">Beginner</title>
  </difficulty>

  <difficulty id="intermediate">
    <title xml:lang="de">Fortgeschritten</title>
    <title xml:lang="en">Intermediate</title>
  </difficulty>

  <difficulty id="expert">
    <title xml:lang="de">Experte</title>
    <title xml:lang="en">Expert</title>
  </difficulty>

  <!-- Not a difficulty step: a duet (student part + teacher part in one MusicXML).
       Shown apart from the difficulties; in the player you choose who plays which part. -->
  <difficulty id="duet" kind="duet">
    <title xml:lang="de">Duett</title>
    <title xml:lang="en">Duet</title>
  </difficulty>
</difficulties>

<!-- Categories shown above the pieces. A composition uses them with <tag>id</tag>;
     tags not listed here are shown with their id. -->
<tags>
  <tag id="children">
    <title xml:lang="de">Kinderlieder</title>
    <title xml:lang="en">Children's songs</title>
  </tag>

  <tag id="classical">
    <title xml:lang="de">Klassik</title>
    <title xml:lang="en">Classical</title>
  </tag>

  <tag id="christmas">
    <title xml:lang="de">Weihnachten</title>
    <title xml:lang="en">Christmas</title>
  </tag>

  <tag id="birthday">
    <title xml:lang="de">Geburtstag</title>
    <title xml:lang="en">Birthday</title>
  </tag>
</tags>

<compositions>

  <composition id="oh-christmas-tree" path="oh-christmas-tree">
    <title xml:lang="de">Oh Tannenbaum</title>
    <title xml:lang="en">Oh Christmas Tree</title>
    <composer>Ernst Anschütz</composer>
    <thumbnail src="oh-christmas-tree/thumbnail.png"/>
    <tags>
      <tag>christmas</tag>
    </tags>
  </composition>

  <composition id="silent-night" path="silent-night">
    <title xml:lang="de">Stille Nacht</title>
    <title xml:lang="en">Silent Night</title>
    <composer>Franz Xaver Gruber</composer>
    <thumbnail src="silent-night/thumbnail.png"/>
    <tags>
      <tag>christmas</tag>
    </tags>
  </composition>

  <composition id="happy-birthday" path="happy-birthday">
    <title xml:lang="de">Happy Birthday</title>
    <title xml:lang="en">Happy Birthday</title>
    <composer>Patty und Mildred Hill</composer>
    <thumbnail src="happy-birthday/thumbnail.png"/>
    <tags>
      <tag>birthday</tag>
    </tags>
  </composition>

  <composition id="fuer-elise" path="fuer-elise">
    <title xml:lang="de">Für Elise</title>
    <title xml:lang="en">Für Elise</title>
    <composer>Ludwig van Beethoven</composer>
    <thumbnail src="fuer-elise/thumbnail.png"/>
    <tags>
      <tag>classical</tag>
    </tags>
  </composition>

  <composition id="ode-to-joy" path="ode-to-joy">
    <title xml:lang="de">Ode an die Freude</title>
    <title xml:lang="en">Ode to Joy</title>
    <composer>Ludwig van Beethoven</composer>
    <thumbnail src="ode-to-joy/thumbnail.png"/>
    <tags>
      <tag>classical</tag>
    </tags>
  </composition>

  <composition id="all-my-little-ducklings" path="all-my-little-ducklings">
    <title xml:lang="de">Alle meine Entchen</title>
    <title xml:lang="en">All My Little Ducklings</title>
    <composer>Ernst Anschütz</composer>
    <thumbnail src="all-my-little-ducklings/thumbnail.png"/>
    <tags>
      <tag>children</tag>
    </tags>
  </composition>

</compositions>

</library>
